        <!-- Card 2 -->
        <xpath expr="//div[hasclass('col-6')][2]" position="attributes">
            <attribute name="class" add="col-lg-3" remove="col-lg-4" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][2]//figure[hasclass('o_card_img_wrapper')]" position="attributes">
            <attribute name="class" add="ratio-1x1" remove="ratio-4x3" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][2]//img" position="attributes">
            <attribute name="class" add="img img-fluid o_we_custom_image" separator=" "/>
            <attribute name="style">padding: 6px;</attribute>
            <attribute name="src">/html_editor/image_shape/website.set_catalog_square_md_2/html_builder/geometric_round/geo_round_circle.svg</attribute>
            <attribute name="data-format-mimetype">image/webp</attribute>
            <attribute name="data-file-name">set_catalog_square_md_2.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_circle</attribute>
            <attribute name="data-shape-colors">;;;;</attribute>
            <attribute name="data-aspect-ratio">1/1</attribute>
        </xpath>
        <!-- Card 3 -->
        <xpath expr="//div[hasclass('col-6')][3]" position="attributes">
            <attribute name="class" add="col-lg-3" remove="col-lg-4" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][3]//figure[hasclass('o_card_img_wrapper')]" position="attributes">
            <attribute name="class" add="ratio-1x1" remove="ratio-4x3" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][3]//img" position="attributes">
            <attribute name="class" add="img img-fluid o_we_custom_image" separator=" "/>
            <attribute name="style">padding: 6px;</attribute>
            <attribute name="src">/html_editor/image_shape/website.set_catalog_square_md_3/html_builder/geometric_round/geo_round_circle.svg</attribute>
            <attribute name="data-format-mimetype">image/webp</attribute>
            <attribute name="data-file-name">set_catalog_square_md_3.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_circle</attribute>
            <attribute name="data-shape-colors">;;;;</attribute>
            <attribute name="data-aspect-ratio">1/1</attribute>
        </xpath>
        <!-- Card 4 -->
        <xpath expr="//div[hasclass('col-6')][4]" position="attributes">
            <attribute name="class" add="col-lg-3" remove="col-lg-4" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][4]//figure[hasclass('o_card_img_wrapper')]" position="attributes">
            <attribute name="class" add="ratio-1x1" remove="ratio-4x3" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][4]//img" position="attributes">
            <attribute name="class" add="img img-fluid o_we_custom_image" separator=" "/>
            <attribute name="style">padding: 6px;</attribute>
            <attribute name="src">/html_editor/image_shape/website.set_catalog_square_md_4/html_builder/geometric_round/geo_round_circle.svg</attribute>
            <attribute name="data-format-mimetype">image/webp</attribute>
            <attribute name="data-file-name">set_catalog_square_md_4.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_circle</attribute>
            <attribute name="data-shape-colors">;;;;</attribute>
            <attribute name="data-aspect-ratio">1/1</attribute>
        </xpath>

        <!-- Remove unnecessary cards -->
        <xpath expr="//div[hasclass('col-6')][5]" position="replace"/>
        <xpath expr="//div[hasclass('col-6')][5]" position="replace"/>
    </template>

