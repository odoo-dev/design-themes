    <!-- CARDS IMAGE GRID -->
    <!-- ================ -->
    <template id="s_cards_grid" inherit_id="website.s_cards_grid">
        <xpath expr="//section" position="attributes">
            <attribute name="class" add="o_cc1" remove="o_cc2" separator=" "/>
        </xpath>
        <!-- Title -->
        <xpath expr="//h2" position="attributes">
            <attribute name="class" remove="h3-fs" separator=" "/>
        </xpath>
        <xpath expr="//h2" position="after">
            <p class="lead"><span class="h6-fs">Discover hundreds of toys for all ages and every interest</span></p>
        </xpath>
        <!-- Card 1 -->
        <xpath expr="(//div[hasclass('s_card')])[1]" position="attributes">
            <attribute name="class" add="shadow-sm" separator=" "/>
        </xpath>
        <!-- Card 2 -->
        <xpath expr="(//div[hasclass('s_card')])[2]" position="attributes">
            <attribute name="class" add="shadow-sm" separator=" "/>
        </xpath>
        <!-- Card 3 -->
        <xpath expr="(//div[hasclass('s_card')])[3]" position="attributes">
            <attribute name="class" add="shadow-sm" separator=" "/>
        </xpath>
        <!-- Card 4 -->
        <xpath expr="(//div[hasclass('s_card')])[4]" position="attributes">
            <attribute name="class" add="shadow-sm" separator=" "/>
        </xpath>

    </template>

    <!-- FOOTER -->
    <!-- ====== -->
    <template id="template_footer_mega_columns" inherit_id="website.template_footer_mega_columns">
        <xpath expr="//div[hasclass('col-lg-4')][1]//div[hasclass('s_text_highlight')]//h4" position="attributes">
            <attribute name="class" add="text-o-color-2" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-lg-4')][2]//div[hasclass('s_text_highlight')]//h4" position="attributes">
            <attribute name="class" add="text-o-color-2" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-lg-4')][3]//div[hasclass('s_text_highlight')]//h4" position="attributes">
            <attribute name="class" add="text-o-color-2" separator=" "/>
        </xpath>
    </template>

</odoo>
