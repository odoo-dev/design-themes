<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- GRADIENT -->
    <!-- ======== -->
    <template id="s_gradient" inherit_id="website.s_gradient">
        <xpath expr="//div[hasclass('o_grid_item')][4]//img" position="attributes">
            <attribute name="src">/html_editor/image_shape/website.set_2_square_md_4/html_builder/geometric_round/geo_round_square_1.svg</attribute>
            <attribute name="data-file-name">geo_round_square_1.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_square_1</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_grid_item')][5]//img" position="attributes">
            <attribute name="src">/html_editor/image_shape/website.set_2_square_md_3/html_builder/geometric_round/geo_round_square_2.svg</attribute>
            <attribute name="data-file-name">geo_round_square_2.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_square_2</attribute>
        </xpath>
    </template>

    <!-- PRODUCT LIST -->
    <!-- ============ -->
    <template id="s_product_list" inherit_id="website.s_product_list">
        <xpath expr="//section" position="attributes">
            <attribute name="class" add="o_cc o_cc1 pb0" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-8')]" position="attributes">
            <attribute name="class" add="pb56" separator=" "/>
        </xpath>
        <xpath expr="//a[hasclass('btn')]" position="attributes">
            <attribute name="class" add="btn-lg" separator=" "/>
        </xpath>
        <!-- Card 1 -->
        <xpath expr="//div[hasclass('col-6')][1]" position="attributes">
            <attribute name="class" add="col-lg-3" remove="col-lg-4" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][1]//figure[hasclass('o_card_img_wrapper')]" position="attributes">
            <attribute name="class" add="ratio-1x1" remove="ratio-4x3" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('col-6')][1]//img" position="attributes">
            <attribute name="class" add="img img-fluid o_we_custom_image" separator=" "/>
            <attribute name="style">padding: 6px;</attribute>
            <attribute name="src">/html_editor/image_shape/website.set_catalog_square_md_1/html_builder/geometric_round/geo_round_circle.svg</attribute>
            <attribute name="data-format-mimetype">image/webp</attribute>
            <attribute name="data-file-name">set_catalog_square_md_1.svg</attribute>
            <attribute name="data-shape">html_builder/geometric_round/geo_round_circle</attribute>
            <attribute name="data-shape-colors">;;;;</attribute>
            <attribute name="data-aspect-ratio">1/1</attribute>
