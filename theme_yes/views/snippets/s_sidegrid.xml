<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_sidegrid" inherit_id="website.s_sidegrid">
    <!-- Images -->
    <xpath expr="//img" position="attributes">
        <attribute name="src">/web/image/website.landscape_md_3</attribute>
    </xpath>
    <xpath expr="(//img)[2]" position="attributes">
        <attribute name="src">/web/image/website.portrait_lg_3</attribute>
    </xpath>
    <xpath expr="(//img)[3]" position="attributes">
        <attribute name="src">/web/image/website.landscape_md_1</attribute>
    </xpath>
    <!-- Title -->
    <xpath expr="//h1" position="replace" mode="inner">
        Experience a lovely wedding experience
    </xpath>
    <!-- Lead -->
    <xpath expr="//p" position="replace" mode="inner">
        A lovely wedding is a joyful celebration of love, marked by touching vows, beautiful decor, and happy faces, creating unforgettable memories.
    </xpath>
</template>

</odoo>
